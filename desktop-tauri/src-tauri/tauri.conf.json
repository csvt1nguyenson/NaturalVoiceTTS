{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NaturalVoice",
  "version": "1.0.0",
  "identifier": "vn.kavomedia.naturalvoice",
  "build": {
    "frontendDist": "../../app/public"
  },
  "app": {
    "windows": [
      {
        "title": "NaturalVoice Desktop",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "resources/ffmpeg.exe"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwRjk4MjZCQ0NENjIwQkMKUldTOElOYk1hNEw1NE1abVZ5THJ4cFVsdytuVS9XbUJoSXBZNmN1SWRFZ0JXZkJNK0tCRFRCVisK",
      "endpoints": [
        "https://github.com/csvt1nguyenson/NaturalVoiceTTS/releases/latest/download/latest.json"
      ]
    }
  }
}